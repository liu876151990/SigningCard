          "content": {
            "size": 899,
            "mimeType": "application/javascript",
            "text": "$(document).ready(function () {\r\n    $.post((window.ecologyContentPath || \"\") + '/api/email/base/getEmailReceiveConfig', function (data) {\r\n        data = $.trim(data);\r\n        if (data == \"\") {\r\n            return;\r\n        }\r\n        var result = new Object();\r\n        try {\r\n            result = $.parseJSON(data);\r\n        } catch (e) {\r\n        }\r\n        var autoreceive = result.autoreceive;\r\n        var outterMail = result.outterMail;\r\n        var timecount = result.timecount;\r\n        // 开启自动接收\r\n        if (outterMail == 1 && autoreceive == 1) {\r\n            jQuery.post((window.ecologyContentPath || \"\") + \"/api/email/base/EmailTimingDateReceiveOperation\");\r\n            window.setInterval(function () {\r\n                jQuery.post((window.ecologyContentPath || \"\") + \"/api/email/base/EmailTimingDateReceiveOperation\");\r\n            }, timecount);\r\n        }\r\n    });\r\n})"
          },
