            "size": 976,
            "mimeType": "application/javascript",
            "text": "$(document).ready(function(){\r\n\tsignPlugin();\r\n})\r\n\r\nfunction signPlugin(){\r\n\t$.get(\"/hrm/resource/getSignInfo.jsp?type=ischeck\",function(data){\r\n\t\tif(data.isNeedSign=='true'){\r\n\t\t\taddButtonPlugin()//弹出框相关\r\n\t\t\tvar addButtonKey =\"signPlugin\";//模块key\r\n\t\t\tvar label;\r\n\t\t\tif(window.ecCom)\r\n\t\t\t\tlabel = window.ecCom.WeaLocaleProvider.getLabel('387307', '考勤');\r\n\t\t\tlabel = label ||  '考勤';\r\n\t\t\tvar addButtonHtmlStr = \"<img onclick=\\\"jQuery(this).next().trigger('click')\\\" src=\\\"/hrm/css/signinfo/rili_wev8.png\\\" style=\\\"vertical-align: middle;cursor:pointer;\\\">\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t + \"<div class=\\\"leftColor SigninfoDiv\\\" onclick=\\\"showsigninfo(this);\\\" style=\\\"display: inline;vertical-align: middle;padding-left: 5px;overflow:hidden;text-overflow:ellipsis;cursor:pointer;\\\" id=\\\"sign_dispan\\\">\"+label+\"</div>\";\r\n\t\t\tgeneratePluginAreaHtml(addButtonHtmlStr,addButtonKey);//向门户右上角添加按钮\r\n\t\t}\r\n\t},\"json\")\r\n}\r\n\r\nfunction addButtonPlugin(){\r\n\t\r\n}\r\n"
          },
