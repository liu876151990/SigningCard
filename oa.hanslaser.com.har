            "size": 2375,
            "mimeType": "text/css",
            "text": ".hrm-birthday .ant-modal-close{background-color:#fff;border-radius:50%;padding:5px;right:-15px;top:-15px}.hrm-birthday .bg{background-size:100% 100%!important;width:100%;height:100%;position:relative;overflow:hidden}.hrm-birthday .bg .cg{position:absolute;left:5%;top:125px;line-height:1.5}.hrm-birthday .bg .date{position:absolute;right:30px;bottom:30px}.hrm-birthday .bg .parent{position:absolute;left:5%;bottom:28px;line-height:1.8;height:147px;width:75%;overflow:hidden}.hrm-birthday .bg .parent .child{position:absolute;width:100%}.hrm-birthday .bg .parent .child .wot,.hrm-birthday .bg .parent .child p,.hrm-birthday .bg .parent .child p .name{white-space:nowrap;overflow:hidden;-o-text-overflow:ellipsis;text-overflow:ellipsis}.hrm-birthday .bg .parent .child p .name{width:15%;display:inline-block;vertical-align:top}.hrm-birthday .bg .parent .child p span:last-child{margin-left:20px;vertical-align:super}.hrm-birthday .bg .parent .child p a{color:inherit!important}.hrm-anniversary .ant-modal-close{background-color:#fff;border-radius:50%;padding:5px;right:-15px;top:-15px}.hrm-anniversary .content{height:100%}.hrm-anniversary .content .bg{position:relative;width:100%;height:100%;overflow:hidden;background-size:100% 100%!important}.hrm-anniversary .content .greeting{width:100%;padding:0 5%;position:absolute}.happy-birthday .ant-modal-close{background-color:#fff;border-radius:50%;padding:5px;right:-15px;top:-15px}.happy-birthday .ellipsis{-o-text-overflow:ellipsis;text-overflow:ellipsis;overflow:hidden;white-space:nowrap}.happy-birthday .person-view{width:350px!important;height:210px}.happy-birthday .person-view .person-content{position:absolute;width:100%}.happy-birthday .person-view .person-content>p{padding:4px 0}.happy-birthday .person-view .person-content .lastname{-o-text-overflow:ellipsis;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;display:inline-block}.happy-birthday .person-view .person-content .lastname a{color:inherit!important}.happy-birthday .person-view .person-content .org{-o-text-overflow:ellipsis;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;display:inline-block;padding-left:5px}.happy-birthday .person-view .person-content .sendLove{-o-text-overflow:ellipsis;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;display:inline-block;cursor:pointer}\n/*# sourceMappingURL=engine.css.map?v=b4262382*/"
          },
