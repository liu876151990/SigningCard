            "text": ".int-plugin-coremail-container{position:relative;width:42px;height:100%;margin:0 5px;cursor:pointer}.int-plugin-coremail-icon-container{width:18px;height:18px;position:absolute;top:50%;margin-top:-9px;left:50%;margin-left:-9px;cursor:pointer}.int-plugin-coremail-icon-container .icon-coms02-core-mail{position:absolute;font-size:24px;top:50%;margin-top:-12px;left:50%;margin-left:-19px}.int-plugin-coremail-total-cnt{position:absolute;top:-13px!important;right:-17px!important;width:25px;height:25px;line-height:22px;text-align:center;border:1px solid #fff;border-radius:50%;background-color:#f64136;color:#fff;font-size:12px;cursor:pointer;font-style:normal}.int-plugin-coremail-detaillist{width:200px;position:relative}.int-plugin-coremail-detail-list{border:1px solid #e3e3e3}.integration_plugin_item{width:100%}.integration_plugin_item:hover{background-color:#eaeaea}.integration_plugin_item .int-plugin-coremail-dt-cnt,.integration_plugin_item .int-plugin-coremail-dt-name{height:40px;line-height:40px;vertical-align:middle}.int-plugin-coremail-detail-list div.int-plugin-coremail-detail-title{background-color:#fff;color:#333;padding-left:5px;font-size:14px;font-weight:500}.int-plugin-coremail-detail-list ul li{border-top:1px solid #efefef;cursor:pointer;position:relative;background-color:#fff}.int-plugin-coremail-detail-list ul li:hover{background:#ebf9ff}.int-plugin-coremail-detail-list ul li .int-plugin-coremail-dt-cnt,.int-plugin-coremail-detail-list ul li .int-plugin-coremail-dt-name,.int-plugin-coremail-detail-list ul li i{position:absolute;top:0}.int-plugin-coremail-pop .ant-popover-inner-content{padding:8px 0}.int-plugin-coremail-pop .int-plugin-coremail-pop-content .integration_plugin_item{padding:0 16px}.int-plugin-coremail-detail-list ul li i{left:5px;color:#0279df;font-size:18px}.int-plugin-coremail-dt-name{left:28px;display:inline-block;width:140px;overflow:hidden;word-break:break-all;-o-text-overflow:ellipsis;text-overflow:ellipsis;white-space:nowrap;color:#333}.int-plugin-coremail-detail-list ul li .int-plugin-coremail-dt-cnt{right:5px;color:#f4565e}\n/*# sourceMappingURL=index.css.map?v=0b6796f8*/"
