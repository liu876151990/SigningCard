            "text": "$(document).ready(function(){\r\n  handleRefreshOauth2Token();\r\n})\r\n\r\nfunction handleRefreshOauth2Token() {\r\n  $.post((window.ecologyContentPath || \"\") + \"/api/integration/oauth2_client/getRefreshTokenCfg\", {}, function(data){\r\n    if(data.refresh_token_isuse == '1' && data.refresh_token_time && Number(data.refresh_token_time) > 0) {\r\n      setInterval(() => {\r\n        $.post((window.ecologyContentPath || \"\") + \"/api/integration/oauth2_client/refreshToken\", {})\r\n      }, Number(data.refresh_token_time)*1000)\r\n    }\r\n  },\"json\");\r\n\r\n  $.post((window.ecologyContentPath || \"\") + \"/api/integration/common1/checkLoginBySSO\", {}, function(data){\r\n    if(data.status == '1') {\r\n      window.localStorage.setItem('loginBySSO', data.loginBySSO)\r\n    } else {\r\n      window.localStorage.setItem('loginBySSO', 'false')\r\n    }\r\n  },\"json\");\r\n}\r\n"
