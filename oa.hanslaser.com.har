            "text": "\t.signinfo .arrowsblock1 {\r\n\t\theight:22px!important;\r\n\t\twidth:240!important;\r\n\t\tposition: absolute;\r\n\t\ttop:-14px;\r\n\t\tpadding-left: 32px;\r\n\t}\r\n\t.signinfo ._browcommgroupblock {\r\n\t\twidth:272px;\r\n\t\tPOSITION:absolute;\r\n\t\tborder-radius: 4px;\r\n\t}\r\n\t\r\n\t.signinfo ._browcommgroupblock .cg_block {\r\n\t\twidth:272px;border:1px solid #D8D8D8;\r\n\t\tfilter:progid:DXImageTransform.Microsoft.Shadow(color=#909090,direction=120,strength=3);/*ie*/\r\n\t\t-moz-box-shadow: 2px 2px 2px #D8D8D8;/*firefox*/\r\n\t\t-webkit-box-shadow: 2px 2px 2px #D8D8D8;/*safari或chrome*/\r\n\t\tbox-shadow:2px 2px 2px #D8D8D8;/*opera或ie9*/\r\n\t\tborder-radius: 4px;\r\n\t}\r\n\t.signinfo .cg_toptitle{\r\n\t\tpadding-top: 24px;\r\n\t\tpadding-left: 12px\r\n\t}\r\n\t\r\n\t.signinfo ._browcommgroupblock .cg_block ul {\r\n\t\twidth: 100%;\r\n\t\tlist-style-position: outside;\r\n\t\tlist-style: none;\r\n\t\tpadding: 0;\r\n\t\tmargin: 0;\r\n\t}\r\n\t\r\n\t.signinfo ._browcommgroupblock .cg_block ul li {\r\n\t\tpadding:3px 5px 3px 12px;\r\n\t\tcursor:pointer;\r\n\t}\r\n\r\n\t.signinfo ._browcommgroupblock .cg_block div{\r\n\t\tcolor: #b2b2b2;\r\n\t\tcursor: pointer;\r\n\t\tfont-size: 14px;\r\n\t}\r\n\r\n\t.signinfo ._browcommgroupblock .cg_block div:hover{\r\n\t\tcolor: #2DB7F5;\r\n\t}\r\n\t\r\n\t.signinfo .emptyRow {\r\n\t\twidth: 70px;\r\n\t\tmargin-top: 32px;\r\n\t}\r\n\t\r\n\t.signinfo .dateArea {\r\n\t\ttext-align: center;\r\n\t\tcolor: #c3c3c3;\r\n\t\twidth: 70px;\r\n\t\tmargin-top: 20px;\r\n\t}\r\n\t\r\n\t.signinfo .discussView {\r\n\t\tpadding-top: 2px;\r\n\t}\r\n\t\r\n\t.signinfo .left {\r\n\t\tfloat: left\r\n\t}\r\n\t\r\n\t.signinfo .right {\r\n\t\tfloat: right\r\n\t}\r\n\t\r\n\t.signinfo .clear {\r\n\t\tclear: both\r\n\t}\r\n\t\r\n\t.signinfo .signItem {\r\n\t\tpadding-top: 10px;\r\n\t\tposition: relative;\r\n\t}\r\n\t.signinfo .signItem .sortInfo>:first-child{\r\n\t\twidth: 100%;\r\n\t} \r\n\r\n\r\n\t.signinfo .signItem .discussitem {\r\n\t\tborder: none;\r\n\t\tbackground: #fff;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .discussline {\r\n\t\tborder-left: 2px solid #e8e8e8;\r\n\t\tposition: absolute;\r\n\t\twidth: 1px;\r\n\t\ttop: 10px;\r\n\t\tbottom: -10px;\r\n\t\tmargin-left: 30px;\r\n\t\tz-index: 1;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .sortInfo {\r\n\t\twidth: 100%;\r\n\t\theight: 20px;\r\n\t\tmargin-top: -15px\r\n\t}\r\n\r\n\t\r\n\t.signinfo .signItem .sortInfo .name {\r\n\t\tcolor: #bbbcbf;\r\n\t\tfloat: left;\r\n\t\tfont-size: 14px;\r\n\t\tmargin-left: 8px;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .sortInfo .signtype {\r\n\t\tcolor: #bbbcbf;\r\n\t\tfloat: left;\r\n\t\tfont-size: 14px;\r\n\t\tmargin-left: 8px;\r\n\t\toverflow: hidden;\r\n\t\twhite-space: nowrap;\r\n\t\ttext-overflow: ellipsis;\r\n\t\t-o-text-overflow: ellipsis;\r\n\t\t-moz-text-overflow: ellipsis;\r\n\t\t-webkit-text-overflow: ellipsis;\r\n\t\tmax-width:25%;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .sortInfo .worktime {\r\n\t\tcolor: #c4c4c53;\r\n\t\tfloat: left;\r\n\t\tfont-size: 14px;\r\n\t\tmargin-left: 8px;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .time {\r\n\t\theight: 20px;\r\n\t\twidth: 20px;\r\n\t\tposition: absolute;\r\n\t\ttop: 10px;\r\n\t\tleft: 55px;\r\n\t\tz-index: 10;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .sortInfo .signtype1 {\r\n\t\tcolor: #1b82e3;\r\n\t\tfloat: left;\r\n\t\tfont-size: 13px;\r\n\t\tmargin-left: 8px;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .sortInfo .signtype2 {\r\n\t\tcolor: #28cb68;\r\n\t\tfloat: left;\r\n\t\tfont-size: 13px;\r\n\t\tmargin-left: 8px;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .state {\r\n\t\theight: 20px;\r\n\t\twidth: 20px;\r\n\t\tposition: absolute;\r\n\t\ttop: 2px;\r\n\t\tleft: 26px;\r\n\t\tz-index: 10;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .splitstate {\r\n\t\theight: 4px;\r\n\t\twidth: 4px;\r\n\t\tposition: absolute;\r\n\t\ttop: -2px;\r\n\t\tleft: 29px;\r\n\t\tz-index: 10;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .substate {\r\n\t\theight: 20px;\r\n\t\twidth: 20px;\r\n\t\tposition: relative;\r\n\t\tleft: 27px;\r\n\t\tz-index: 10;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .reportContent table {\r\n\t\tborder-collapse: collapse;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .reportContent {\r\n\t\tpadding: 4px 4px 4px 10px;\r\n\t\tword-break: break-all;\r\n\t\toverflow: auto;\r\n\t\tcursor: text;\r\n\t\ttext-align: left !important;\r\n\t}\r\n\t\r\n\t.signinfo .reportContent p {\r\n\t\tmargin: 0px\r\n\t}\r\n\t\r\n\t.signinfo .dotedLine {\r\n\t\tborder-bottom: 1px solid #D8D8D8;\r\n\t\tmargin-left: 30px;\r\n\t\tline-height: 1px;\r\n\t\tpadding-top: 10px;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .img001 {\r\n\t\tbackground: url(/hrm/css/signinfo/rili1_wev8.png) no-repeat;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .img003 {\r\n\t\tbackground: url(/hrm/css/signinfo/blue_wev8.png) no-repeat;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .img004 {\r\n\t\tbackground: url(/hrm/css/signinfo/green_wev8.png) no-repeat;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .img005 {\r\n\t\tbackground: url(/hrm/css/signinfo/split_wev8.png) no-repeat;\r\n\t}\r\n\t\r\n\t.signinfo .signItem .dateinfo {\r\n\t\tmargin: 0px 0px 0px 14px;\r\n\t\tcolor: #4c4c53;\r\n\t\tfont-size: 16px;\r\n\t\tposition: absolute;\r\n\t  top: 10px;\r\n\t  left: 70px;\r\n\t}\r\n\t\r\n\t.signinfo .img {\r\n\t\twidth: 12px;\r\n\t\theight: 45px;\r\n\t\tfloat: left;\r\n\t}\r\n"
